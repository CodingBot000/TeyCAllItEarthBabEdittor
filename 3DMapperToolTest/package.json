{
  "name": "3d-mapper-tool-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run assets:verify-external && npm run assets:check-untracked",
    "assets:build": "node scripts/build-building-assets.mjs",
    "assets:verify": "node scripts/verify-migration.mjs",
    "assets:catalog:build": "node scripts/build-glb-migration-manifest.mjs",
    "assets:verify-external": "node scripts/verify-external-glb-assets.mjs",
    "assets:check-untracked": "node scripts/check-no-tracked-glb.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.12.1",
    "@babylonjs/loaders": "9.12.1",
    "@babylonjs/materials": "9.12.1",
    "@babylonjs/serializers": "9.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.15.21",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "sharp": "0.34.3",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
